# ─────────────────────────────────────────────
#  CRM UI — Environment Variables
# ─────────────────────────────────────────────
#  Copy this file to .env.development (for local dev) or .env (for production).
# ─────────────────────────────────────────────

# URL of your backend API server — implement the routes from API_SPEC.md.
# Example: http://localhost:8000
VITE_BACKEND_URL=

# Mock mode — set to "true" to run the full CRM with in-memory fake data.
# No backend required. Data resets on page refresh.
# VITE_MOCK=true

# Dev user — bypasses the login screen and seeds the user_id cookie.
# Useful when developing UI without an auth flow.
# VITE_DEV_USER=you@example.com

# WebSocket server URL for real-time updates (optional).
# Leave unset to disable real-time — the app works without it.
VITE_SOCKET_URL=

# Site name (Frappe-specific, leave unset for other backends)
VITE_SITE_NAME=

# CSRF token (Frappe-specific, leave unset for other backends)
VITE_CSRF_TOKEN=
