# ─────────────────────────────────────────────
#  CRM UI — Environment Variables
# ─────────────────────────────────────────────
#  Copy this file to .env.development (for local dev) or .env (for production).
#  All variables are optional when running on a Frappe bench — Frappe injects
#  them via window.* globals. Set them when using any other backend.
# ─────────────────────────────────────────────

# URL of your backend API server
# Example: http://localhost:8000  (Django/Node/etc local dev)
# Frappe users: leave unset — handled automatically
VITE_BACKEND_URL=

# WebSocket server URL for real-time updates
# Example: http://localhost:9000
# Leave unset to disable real-time features (app still works without it)
VITE_SOCKET_URL=

# Site name (Frappe-specific, leave unset for other backends)
VITE_SITE_NAME=

# CSRF token (Frappe-specific, leave unset for other backends)
VITE_CSRF_TOKEN=
